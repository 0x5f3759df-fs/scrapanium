+#define SP_WS_RECV_CHUNK 16384u
+
+static size_t sp_ws_input_available(const sp_ws *w) {
+  return w->input_size - w->input_offset;
+}
+
+static int sp_ws_recv_error(sp_ws_io *io, CURLcode code) {
+  return sp_ws_io_end(io, code == CURLE_GOT_NOTHING ? SP_CLOSED : SP_TRANSPORT);
+}
+
+/* The per-socket read-ahead buffer amortizes small frames and survives message
+ * returns. It is allocated only if the peer sends bytes that need buffering. */
+static int sp_ws_raw_fill(sp_ws_io *io) {
+  sp_ws *w = io->socket;
+  if (sp_ws_input_available(w)) return SP_OK;
+  w->input_offset = w->input_size = 0;
+  if (!w->input) {
+    w->input = malloc(SP_WS_RECV_CHUNK);
+    if (!w->input) return sp_ws_io_end(io, SP_NOMEM);
+  }
+  size_t got = 0;
+  CURLcode code = curl_easy_recv(w->session->slots[0].easy,
+                                 w->input, SP_WS_RECV_CHUNK, &got);
+  if (code == CURLE_AGAIN) {
+    if (got) return sp_ws_io_end(io, SP_TRANSPORT);
+    io->events = POLLIN;
+    return SP_WS_PENDING;
+  }
+  if (code != CURLE_OK) return sp_ws_recv_error(io, code);
+  if (!got) return sp_ws_io_end(io, SP_CLOSED);
+  w->input_size = got;
+  return SP_OK;
+}
+
+/* Large payload tails bypass the read-ahead buffer when it is empty. */
+static int sp_ws_raw_direct(sp_ws_io *io, unsigned char *out, size_t want,
+                            size_t *got_out) {
+  sp_ws *w = io->socket;
+  *got_out = 0;
+  if (sp_ws_input_available(w)) return SP_INVALID;
+  size_t got = 0;
+  CURLcode code = curl_easy_recv(w->session->slots[0].easy, out, want, &got);
+  if (code == CURLE_AGAIN) {
+    if (got) return sp_ws_io_end(io, SP_TRANSPORT);
+    io->events = POLLIN;
+    return SP_WS_PENDING;
+  }
+  if (code != CURLE_OK) return sp_ws_recv_error(io, code);
+  if (!got) return sp_ws_io_end(io, SP_CLOSED);
+  *got_out = got;
+  return SP_OK;
+}
+
+static void sp_ws_raw_consume(sp_ws *w, size_t amount) {
+  w->input_offset += amount;
+  if (w->input_offset == w->input_size)
+    w->input_offset = w->input_size = 0;
+}
+
+static int sp_ws_reserve(sp_buffer *message, size_t minimum,
+                         size_t announced, int final) {
+  if (minimum > message->limit - message->size) return message->limit_error;
+  size_t need = message->size + minimum;
+  size_t target = need;
+  if (!message->cap || final) {
+    size_t hint = announced < 262144 ? announced : 262144;
+    if (hint > target) target = hint;
+  }
+  if (target <= message->cap) return SP_OK;
+  size_t cap;
+  if (final && announced <= 262144) cap = announced;
+  else {
+    cap = message->cap ? message->cap : (target > 256 ? target : 256);
+    while (cap < target) {
+      if (cap > SIZE_MAX / 2) { cap = target; break; }
+      cap *= 2;
+    }
+  }
+  if (cap > message->limit) cap = message->limit;
+  unsigned char *buffer = realloc(message->data, cap);
+  if (!buffer) return SP_NOMEM;
+  message->data = buffer;
+  message->cap = cap;
+  return SP_OK;
+}
+
+static int sp_ws_io_header(sp_ws_io *io) {
+  sp_ws *w = io->socket;
+  while (!io->frame_ready) {
+    while (io->header_have < io->header_need) {
+      int result = sp_ws_raw_fill(io);
+      if (result) return result;
+      size_t available = sp_ws_input_available(w);
+      size_t need = io->header_need - io->header_have;
+      size_t take = available < need ? available : need;
+      memcpy(io->header + io->header_have, w->input + w->input_offset, take);
+      io->header_have += take;
+      sp_ws_raw_consume(w, take);
+    }
+
+    if (!io->header_base_checked) {
+      unsigned char first = io->header[0], second = io->header[1];
+      unsigned opcode = first & 0x0f;
+      unsigned marker = second & 0x7f;
+      if ((first & 0x70) || (second & 0x80) ||
+          !(opcode == 0 || opcode == 1 || opcode == 2 ||
+            opcode == 8 || opcode == 9 || opcode == 10))
+        return sp_ws_io_end(io, SP_PROTOCOL);
+      io->frame_opcode = opcode;
+      io->frame_fin = !!(first & 0x80);
+      io->header_need = 2 + (marker == 126 ? 2 : marker == 127 ? 8 : 0);
+      io->header_base_checked = 1;
+      if (io->header_have < io->header_need) continue;
+    }
+
+    unsigned marker = io->header[1] & 0x7f;
+    uint64_t length = marker;
+    if (marker == 126) {
+      length = ((uint64_t)io->header[2] << 8) | io->header[3];
+      if (length < 126) return sp_ws_io_end(io, SP_PROTOCOL);
+    }
+    else if (marker == 127) {
+      if (io->header[2] & 0x80) return sp_ws_io_end(io, SP_PROTOCOL);
+      length = 0;
+      for (unsigned i = 2; i < 10; i++)
+        length = (length << 8) | io->header[i];
+      if (length <= 65535) return sp_ws_io_end(io, SP_PROTOCOL);
+    }
+
+    unsigned opcode = io->frame_opcode;
+    int control = opcode >= 8;
+    if (control) {
+      if (!io->frame_fin || marker > 125 || length > sizeof io->control)
+        return sp_ws_io_end(io, SP_PROTOCOL);
+      io->control_size = 0;
+    }
+    else {
+      if (opcode == 1 || opcode == 2) {
+        if (io->message_kind) return sp_ws_io_end(io, SP_PROTOCOL);
+        io->message_kind = opcode == 1 ? 1 : 2;
+      }
+      else if (!io->message_kind) return sp_ws_io_end(io, SP_PROTOCOL);
+      if (length > (uint64_t)(io->message.limit - io->message.size))
+        return sp_ws_io_end(io, SP_BODY_LIMIT);
+    }
+    io->frame_payload_left = length;
+    io->frame_ready = 1;
+  }
+  return SP_OK;
+}
+
+static int sp_ws_io_payload(sp_ws_io *io) {
+  sp_ws *w = io->socket;
+  if (!io->frame_payload_left) return SP_OK;
+  if (io->frame_opcode >= 8) {
+    int result = sp_ws_raw_fill(io);
+    if (result) return result;
+    size_t available = sp_ws_input_available(w);
+    size_t take = available;
+    if ((uint64_t)take > io->frame_payload_left)
+      take = (size_t)io->frame_payload_left;
+    memcpy(io->control + io->control_size, w->input + w->input_offset, take);
+    io->control_size += take;
+    io->frame_payload_left -= take;
+    sp_ws_raw_consume(w, take);
+    return SP_OK;
+  }
+
+  sp_buffer *message = &io->message;
+  if (!sp_ws_input_available(w) &&
+      io->frame_payload_left >= SP_WS_RECV_CHUNK) {
+    size_t want = SP_WS_RECV_CHUNK;
+    int result = sp_ws_reserve(message, want,
+      message->size + (size_t)io->frame_payload_left,
+      io->frame_fin);
+    if (result) return sp_ws_io_end(io, result);
+    size_t got = 0;
+    result = sp_ws_raw_direct(io, message->data + message->size, want, &got);
+    if (result) return result;
+    message->size += got;
+    io->frame_payload_left -= got;
+    return SP_OK;
+  }
+
+  if (!sp_ws_input_available(w)) {
+    int result = sp_ws_raw_fill(io);
+    if (result) return result;
+  }
+  size_t available = sp_ws_input_available(w);
+  size_t take = available;
+  if ((uint64_t)take > io->frame_payload_left)
+    take = (size_t)io->frame_payload_left;
+  int result = sp_ws_reserve(message, take,
+    message->size + (size_t)io->frame_payload_left,
+    io->frame_fin);
+  if (result) return sp_ws_io_end(io, result);
+  memcpy(message->data + message->size, w->input + w->input_offset, take);
+  message->size += take;
+  io->frame_payload_left -= take;
+  sp_ws_raw_consume(w, take);
+  return SP_OK;
+}
+
+static void sp_ws_io_frame_reset(sp_ws_io *io) {
+  io->header_have = 0;
+  io->header_need = 2;
+  io->header_base_checked = 0;
+  io->frame_ready = 0;
+  io->frame_fin = 0;
+  io->frame_opcode = 0;
+  io->frame_payload_left = 0;
+}
+
+static int sp_ws_io_finish_frame(sp_ws_io *io) {
+  unsigned opcode = io->frame_opcode;
+  int fin = io->frame_fin;
+  sp_ws_io_frame_reset(io);
+
+  if (opcode == 9) {
+    sp_ws_io_send(io, 10, io->control, io->control_size, 1);
+    return SP_OK;
+  }
+  if (opcode == 10) return SP_OK;
+  if (opcode == 8) {
+    if (!sp_ws_close_valid(io->control, io->control_size))
+      return sp_ws_io_end(io, SP_PROTOCOL);
+    if (!io->socket->closing)
+      sp_ws_io_send(io, 8, io->control, io->control_size, 2);
+    else
+      return sp_ws_io_close_message(io);
+    return SP_OK;
+  }
+
+  if (fin) {
+    unsigned kind = io->message_kind;
+    if (kind == 1 && !sp_ws_utf8(io->message.data, io->message.size))
+      return sp_ws_io_end(io, SP_PROTOCOL);
+    io->message_kind = 0;
+    if (io->operation == SP_WS_CLOSE) {
+      free(io->message.data);
+      io->message = (sp_buffer){
+        .limit = io->socket->session->config.max_body_bytes,
+        .limit_error = SP_BODY_LIMIT
+      };
+    }
+    else {
+      io->kind = kind;
+      return sp_ws_io_end(io, SP_OK);
+    }
+  }
+  return SP_OK;
+}
