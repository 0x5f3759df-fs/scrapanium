@@ -1961,15 +1965,44 @@
     ctx.buflen = buflen;
 
     while(1) {
+      /* A terminal read status after payload bytes is delivered on the next
+       * call, after any plaintext already buffered in recvbuf is decoded. */
+      if(Curl_bufq_is_empty(&ws->recvbuf) && ws->deferred_recv_error) {
+        if(ctx.written) {
+          result = CURLE_OK;
+          break;
+        }
+        result = ws->deferred_recv_error;
+        ws->deferred_recv_error = CURLE_OK;
