+  if(!values || capacity < CURL_WS_DIAG_SNAPSHOT_COUNT)
+    return;
+  for(i = 0; i < CURL_WS_DIAG_COUNTER_COUNT; ++i)
+    values[i] = atomic_load_explicit(&Curl_ws_diag_counters[i],
+                                     memory_order_relaxed);
+  values[CURL_WS_DIAG_LAYOUT_CHUNK_SIZE] = sizeof(struct buf_chunk);
+  values[CURL_WS_DIAG_LAYOUT_BUFQ_SIZE] = sizeof(struct bufq);
+  values[CURL_WS_DIAG_LAYOUT_PIN_SIZE] = Curl_bufq_pin_struct_size();
+  values[CURL_WS_DIAG_LAYOUT_PAYLOAD_SIZE] = sizeof(struct curl_ws_payload);
+  values[CURL_WS_DIAG_LAYOUT_RECV_CHUNK_SIZE] = WS_CHUNK_SIZE;
+}
