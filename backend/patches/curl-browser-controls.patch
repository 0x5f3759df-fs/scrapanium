+/* nghttp2 opens a client stream when its request HEADERS are sent. Queue the
+ * advertised per-stream increment here, after HEADERS, including on multiplexed
+ * streams. The connection's currently active easy handle may be a different
+ * request: always get the stream owner from nghttp2. */
+static int on_profile_frame_send(nghttp2_session *session,
+                                 const nghttp2_frame *frame, void *userp)
+{
+  struct Curl_cfilter *cf = userp;
+  struct cf_h2_ctx *ctx = cf->ctx;
+  if(frame->hd.type == NGHTTP2_HEADERS &&
+     frame->headers.cat == NGHTTP2_HCAT_REQUEST) {
+    struct Curl_easy *owner =
+      nghttp2_session_get_stream_user_data(session, frame->hd.stream_id);
+    if(owner && owner->set.http2_stream_window) {
+      int32_t target = owner->set.http2_stream_window;
+      struct h2_stream_ctx *stream = H2_STREAM_CTX(ctx, owner);
+      if((uint32_t)target < ctx->initial_win_size || !stream)
+        return NGHTTP2_ERR_CALLBACK_FAILURE;
+      if((uint32_t)target > ctx->initial_win_size &&
+         nghttp2_submit_window_update(session, NGHTTP2_FLAG_NONE,
+           frame->hd.stream_id, target - (int32_t)ctx->initial_win_size))
+        return NGHTTP2_ERR_CALLBACK_FAILURE;
+      stream->local_window_size = target;
+    }
+  }
+#ifdef CURLVERBOSE
+  return on_frame_send(session, frame, userp);
+#else
+  return 0;
+#endif
+}
 
